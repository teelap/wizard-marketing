# YouTube channel ID to pull the latest video from
YOUTUBE_CHANNEL_ID=UC26G_o-cTFCcPo-CyGf_3YA

# TikTok creator handle (no @)
TIKTOK_USERNAME=thewizardmarketing

# Path to the HTML file the build script mutates
INDEX_PATH=./index.html

# Per-request HTTP timeout (ms)
FETCH_TIMEOUT_MS=10000

# Fail the build when feed containers are missing (otherwise log and skip)
STRICT=0
